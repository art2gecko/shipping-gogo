# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipping_gogo?schema=public"

# ── App ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Shipment folder root (absolute or relative to project) ──
SHIPMENT_ROOT="./Shipments"

# ── Seed defaults (used by prisma/seed.ts) ────────────────
ADMIN_PASSWORD="admin123"
WAREHOUSE_PASSWORD="warehouse123"

# ── Token Encryption (required for integrations) ─────────
TOKEN_ENCRYPTION_KEY="change-me-to-a-random-32-char-secret"

# ── Frontend URL (for OAuth callback redirects) ──────────
FRONTEND_URL="http://localhost:5173"

# ── eBay OAuth ───────────────────────────────────────────
# Get credentials at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_REDIRECT_URI="http://localhost:3000/api/integrations/ebay/callback"

# ── Amazon SP-API / Login with Amazon ────────────────────
# LWA App: https://sellercentral.amazon.com/apps/manage
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
AMAZON_REDIRECT_URI="http://localhost:3000/api/integrations/amazon/callback"
# AWS credentials for SP-API SigV4 signing (optional until fully implemented)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
SPAPI_ROLE_ARN=""

# ── Temu Open Platform ──────────────────────────────────
TEMU_APP_KEY=""
TEMU_APP_SECRET=""
TEMU_REDIRECT_URI="http://localhost:3000/api/integrations/temu/callback"
# Optional: override Temu API endpoints per region
TEMU_AUTH_URL=""
TEMU_TOKEN_URL=""
TEMU_API_BASE_URL=""
