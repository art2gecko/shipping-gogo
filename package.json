{
  "name": "shipping-gogo",
  "version": "0.1.0",
  "description": "Fulfillment Orchestrator – multi-marketplace order normalization, label purchasing, batching, and document generation",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate || true",
    "dev": "npx ts-node src/index.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "env:init": "test -f .env || cp .env.example .env",
    "setup": "npm run env:init && npx prisma generate && npx prisma migrate deploy && npx prisma db seed",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
